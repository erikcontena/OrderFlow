# Lighter Exchange Environment Variables

# Lighter Mode: "testnet" or "mainnet" (defaults to testnet)
LIGHTER_MODE="testnet"

# API & Account settings (Never hardcode private keys in code)
# Your L1 Ethereum private key for signing operations (or API Key if pre-registered)
LIGHTER_PRIVATE_KEY="dc63e915118360c65304f013785fe8d10f8b3f9c986e7792e906582472f22b0726b70809eae3d36d"

# L1 Address / Account Index (default 0 for master)
LIGHTER_ACCOUNT_INDEX="275"

# API Key Index (0-3 reserved, 4-254 for custom API keys)
LIGHTER_API_KEY_INDEX="4"

# If true, runs the bot with simulated state regardless of live connection, 
# acting as a paper-trading mechanism against live data.
LIGHTER_PAPER_TRADING="True"
